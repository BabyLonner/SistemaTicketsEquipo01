# Copia este archivo como .env (no se sube a GitHub)
# ===== LOCAL (XAMPP) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mesa_ayuda_ti

# ===== PYTHONANYWHERE (base asignada por el profesor) =====
# DB_HOST=jcachay.mysql.pythonanywhere-services.com
# DB_USER=jcachay
# DB_PASSWORD=********
# DB_NAME=jcachay$dawagr1

# Frases largas y distintas (nadie más debe conocerlas)
SECRET_KEY=cambia-esta-frase-larga
JWT_SECRET=cambia-esta-otra-frase-larga
CORREO_SOPORTE=soporte@mesadeayuda.com.pe

# ===== MÓDULO 4: avisos por WhatsApp con Vonage (ver MODULO4_WHATSAPP.md) =====
# Claves del panel de Vonage (dashboard.vonage.com → API Settings). NUNCA las subas a GitHub.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_CANAL=whatsapp
VONAGE_SANDBOX=1
VONAGE_WHATSAPP_FROM=14157386102
VONAGE_SMS_FROM=MesaTI
# Frase secreta que va al final de la URL del webhook (?token=...). Inventa una larga.
VONAGE_WEBHOOK_TOKEN=cambia-este-token-del-webhook
# Dirección pública del sistema, para el enlace del mensaje (ngrok o PythonAnywhere)
APP_URL_PUBLICA=

# ===== MÓDULO 7: alertas Web Push de SLA =====
# Genera el par con: python generar_vapid.py  (usa el MISMO par en tu PC y en PythonAnywhere)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
