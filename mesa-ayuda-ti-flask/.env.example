# Copia este archivo como .env y cambia los valores
SECRET_KEY=cambia-esta-clave-larga-y-secreta
JWT_SECRET_KEY=cambia-esta-otra-clave-larga-y-secreta

# SQLite por defecto. Para PostgreSQL:
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/mesa_ayuda
DATABASE_URL=

CORREO_SOPORTE=soporte@empresa.pe
ZONA_HORARIA=America/Lima

# 1 solo cuando uses HTTPS
COOKIE_SECURE=0

# Muestra los botones de cuentas de prueba en el login (pon 0 en producción)
MOSTRAR_CUENTAS_DEMO=1
