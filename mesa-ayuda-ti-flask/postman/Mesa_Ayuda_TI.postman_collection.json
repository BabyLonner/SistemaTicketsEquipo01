{
  "info": {
    "name": "Mesa de Ayuda TI · API REST",
    "description": "API del sistema de tickets de TI. Primero ejecuta 'Iniciar sesión': el token se guarda solo y las demás peticiones lo envían en el header Authorization: Bearer {{token}}.\n\nCódigos: 200 OK, 201 creado, 204 sin contenido, 401 sin token o token inválido, 403 sin permiso, 404 no existe, 409 conflicto, 422 datos inválidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ticket_id",
      "value": "1"
    },
    {
      "key": "usuario_id",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve el token JWT. El script de pruebas lo guarda en la variable {{token}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"ana.diaz@empresa.pe\",\n  \"password\": \"demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "if (datos.access_token) { pm.collectionVariables.set('token', datos.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/yo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "yo"
              ]
            },
            "description": "Datos del usuario dueño del token."
          }
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Invalida el token actual (queda en la lista de revocados)."
          }
        }
      ]
    },
